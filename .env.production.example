APP_ENV=production
REQUIRE_AUTH=true
ENABLE_LOCAL_USER_FALLBACK=false
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMIT=true
AUTH_SECRET=change-me-long-random-32-bytes-minimum
ACCESS_TOKEN_TTL_MINUTES=60
SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback
INVITATION_TTL_HOURS=168

POSTGRES_DB=aiwana
POSTGRES_USER=aiwana
POSTGRES_PASSWORD=change-me-long-random
DATABASE_BACKEND=postgres

ENABLE_REDIS=true
RATE_LIMIT_BACKEND=redis
SESSION_BACKEND=redis
AGENT_STATE_BACKEND=redis
CACHE_BACKEND=redis

QDRANT_COLLECTION=aiwana_chunks_v2
QDRANT_TENANT_MODE=shared_collection
OBJECT_STORAGE_KMS_KEY_ID=
OBJECT_STORAGE_SIGNED_URL_EXPIRY_SECONDS=900
OBJECT_STORAGE_S3_LIFECYCLE_DOCUMENTED=false
TENANT_DATA_PLANE_MODE=shared
ENABLE_NAMED_VECTORS=true
ENABLE_GRAPH_MEMORY=true
GRAPH_BACKEND=postgres
ENABLE_REAL_ORCHESTRATOR=true
ENABLE_QUEUE_INGESTION=true

LLM_PROVIDER=groq
LLM_PRIVACY_MODE=external_allowed
LLM_BASE_URL=
LLM_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
GROQ_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_PROVIDER_ENABLED=true
HUGGINGFACE_MODEL_CACHE=/app/models/huggingface
HUGGINGFACE_TASK_ENABLES=entity_extraction=true,document_classification=true,evidence_checking=true,reranking=false
HF_EMBEDDINGS_ENABLED=false
HF_RERANKING_ENABLED=false
HF_ENTITY_EXTRACTION_ENABLED=true
HF_EVIDENCE_CHECKING_ENABLED=true
HF_CLASSIFICATION_ENABLED=true
HF_CAPTIONING_ENABLED=false
HF_OCR_VLM_ENABLED=false
HUGGINGFACE_MAX_SECONDS=30
HUGGINGFACE_MAX_MEMORY_MB=4096
RETRIEVAL_CACHE_TTL_SECONDS=600
RETRIEVAL_CACHE_BYPASS=false
GRAPH_EVAL_REQUIRED=true
GRAPH_EVAL_MIN_LIFT=0.05
RERANK_MAX_CANDIDATES=20
RERANK_BATCH_SIZE=16
RERANK_TIMEOUT_SECONDS=3
FAST_RETRIEVAL_K=24
FAST_CONTEXT_K=6
BALANCED_RETRIEVAL_K=30
BALANCED_RERANK_K=15
BALANCED_CONTEXT_K=8
DEEP_RETRIEVAL_K=60
DEEP_RERANK_K=30
DEEP_CONTEXT_K=12
SIGNED_URL_EXPIRY_SECONDS=300
CHAT_RETENTION_DAYS=90
QUERY_LOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
DELETED_DOCUMENT_RETENTION_DAYS=30

MINIO_ROOT_USER=aiwana
MINIO_ROOT_PASSWORD=change-me-long-random
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

AIWANA_SMOKE_STRICT=true
AIWANA_SMOKE_BOOTSTRAP=false
AIWANA_SMOKE_WORKSPACE=default
AIWANA_SMOKE_TOKEN=
AIWANA_SMOKE_EMAIL=
AIWANA_SMOKE_PASSWORD=

# Optional graph profile
NEO4J_AUTH=neo4j/change-me-long-random
