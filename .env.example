# Offline-safe local model paths. Keep these set for local and Docker runs.
APP_NAME=Adaptive Multimodal RAG
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Qdrant server is used in Docker. Local fallback is used automatically if unavailable.
QDRANT_URL=http://qdrant:6333
QDRANT_LOCAL_FALLBACK_URL=file://./data/qdrant_local
QDRANT_COLLECTION=aiwana_chunks_v2
QDRANT_TENANT_MODE=shared_collection

DATABASE_URL=postgresql+psycopg://aiwana:aiwana@postgres:5432/aiwana
DATABASE_BACKEND=postgres
SQLITE_DATABASE_URL=sqlite:///./data/metadata.db
ENABLE_SQLITE_FALLBACK=false

REDIS_URL=redis://redis:6379/0
ENABLE_REDIS=true
RATE_LIMIT_BACKEND=redis
SESSION_BACKEND=redis
AGENT_STATE_BACKEND=redis
CACHE_BACKEND=redis

OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=aiwana-artifacts
OBJECT_STORAGE_LOCAL_DIR=./data/artifacts
OBJECT_STORAGE_KMS_KEY_ID=
OBJECT_STORAGE_SIGNED_URL_EXPIRY_SECONDS=900
OBJECT_STORAGE_S3_LIFECYCLE_DOCUMENTED=false
TENANT_DATA_PLANE_MODE=shared
SIGNED_URL_EXPIRY_SECONDS=300
ENABLE_GRAPH_MEMORY=true
GRAPH_BACKEND=postgres
ENABLE_REAL_ORCHESTRATOR=true

EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=./models/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=32
HF_HOME=/models/huggingface

# Leave provider keys blank for fully offline grounded fallback mode.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_PRIVACY_MODE=external_allowed
LLM_BASE_URL=
LLM_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
GROQ_API_KEY=
OPENAI_API_KEY=
ENABLE_OPENAI_FALLBACK=false

ENABLE_HYBRID=true
ENABLE_RERANKER=true
RERANKER_REQUIRED=false
RERANK_MAX_CANDIDATES=20
RERANK_BATCH_SIZE=16
RERANK_TIMEOUT_SECONDS=3
FAST_RETRIEVAL_K=24
FAST_CONTEXT_K=6
BALANCED_RETRIEVAL_K=30
BALANCED_RERANK_K=15
BALANCED_CONTEXT_K=8
DEEP_RETRIEVAL_K=60
DEEP_RERANK_K=30
DEEP_CONTEXT_K=12
ENABLE_ROUTER=true
ENABLE_MULTIMODAL=true
ENABLE_GRAPH=false
ENABLE_NAMED_VECTORS=true
ENABLE_BGE_M3_SPARSE=false
ENABLE_PERSISTENT_MEMORY=true
ENABLE_RATE_LIMIT=true
ENABLE_SECURITY_HEADERS=true
REQUIRE_AUTH=true
ENABLE_LOCAL_USER_FALLBACK=false
AUTH_SECRET=change-me-in-any-shared-environment
ACCESS_TOKEN_TTL_MINUTES=60
SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
INVITATION_TTL_HOURS=168
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

MAX_UPLOAD_FILES=8
MAX_UPLOAD_MB=80
MAX_WORKSPACE_DOCUMENTS=50
MAX_PASTED_TEXT_CHARS=500000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RETENTION_DAYS=90
QUERY_LOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
DELETED_DOCUMENT_RETENTION_DAYS=30

CHUNK_SIZE=800
CHUNK_OVERLAP=120
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
DEFAULT_TOP_K=5
RETRIEVAL_CANDIDATE_POOL=12
MAX_CONTEXT_CHUNKS=6
MIN_CONFIDENCE_TO_ANSWER=0.42

DATA_DIR=./data
UPLOAD_DIR=./data/uploads
LOG_DIR=./data/logs
METADATA_DB=./data/metadata.db
BACKUP_DIR=./data/backups
